# Personal data belongs in these local-only directories, never in source/tests.
/private-data/
/personal-backups/
/personal-diaries/

# Application downloads, including browser-generated duplicate filenames.
what-to-do-backup*.json
what-to-do-original*.txt
what-to-do-timer-original*.txt
localStorage-export*.json
localstorage-export*.json
whatToDoData*.json
activeTimer*.json

# Local credentials; keep safe example configuration available to Git.
.env
.env.*
!.env.example
!.env.template

# Dependencies, generated output and local test artifacts.
node_modules/
/dist/
/build/
/coverage/
/test-results/
/playwright-report/
/test-artifacts/
/docs/development/book-c-2026-11-05/independent-evidence*/
/docs/development/book-c-2026-11-05/calendar-independent-evidence*/
/docs/development/book-feedback-2026-11-06/figma-sync/*.png
/docs/development/book-feedback-2026-11-06/figma-sync-evidence.zip
.cache/
.tmp/
*.log
*.log.*

# Editor temporary files and operating system metadata.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local Android SDK, intermediates and private APK signing identity.
/android/.build/
/android/.signing/
/android/local.properties
*.jks
*.keystore
